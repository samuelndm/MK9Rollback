// Resources of "MK9 Rollback.exe": its icon (launcher\app.ico, written by tools\make_icon.ps1), its manifest and the
// details Windows shows for the file (Properties > Details, Task Manager, the "unknown publisher" prompts).
#include <windows.h>

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MK9 Rollback (open source)"
            VALUE "FileDescription", "MK9 Rollback"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "MK9Rollback"
            VALUE "LegalCopyright", "Open source: github.com/samuelndm/MK9Rollback. Not affiliated with Warner Bros. or NetherRealm Studios."
            VALUE "OriginalFilename", "MK9 Rollback.exe"
            VALUE "ProductName", "MK9 Rollback"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
